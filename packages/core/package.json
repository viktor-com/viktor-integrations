{
  "name": "@viktor/integrations-core",
  "version": "0.1.0",
  "description": "Shared core for Viktor framework integrations: thin client, stream parsing, errors, tool-id routing, delegate tool.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
