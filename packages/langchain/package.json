{
  "name": "@viktor-com/langchain",
  "version": "0.1.0",
  "description": "LangChain.js integration for Viktor, the AI employee: ChatViktor chat model, delegate tool, LangGraph handoff helper.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viktor-com/viktor-integrations.git",
    "directory": "packages/langchain"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "viktor",
    "agent",
    "chat-model"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph.d.ts",
      "default": "./dist/langgraph.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@viktor-com/integrations-core": "^0.1.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/openai": "^1.5.0",
    "@langchain/langgraph": "^1.4.4"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/openai": "^1.5.0",
    "@langchain/langgraph": "^1.4.0",
    "langchain": "^1.5.0",
    "zod": "^4.1.8"
  }
}
