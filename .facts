  command: python/.venv/bin/python -c "import json,urllib.request,jsonschema; d=json.load(open('mcp/server.json')); s=json.load(urllib.request.urlopen(d['\$schema'])); jsonschema.validate(d,s); assert d['remotes'][0]['headers'][0]['isSecret']"
