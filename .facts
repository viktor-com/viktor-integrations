  command: test -f packages/core/test/live.test.ts && test -f python/core/tests/test_live.py && (cd packages/core && env -u VIKTOR_API_KEY npx vitest run test/live.test.ts 2>&1 | grep -q 'LIVE CONTRACT TEST SKIPPED')
  tags: [implemented]

